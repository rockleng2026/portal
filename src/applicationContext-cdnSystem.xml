<?xml version="1.0" encoding="UTF-8"?>
<beans
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	 http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
	 ">
	 
	<!-- >>>>>>>>>>>>>>>>>>>>>cdn   Dao层的注入<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
	<bean id="cdnSystemDao" class="com.fuao.fajxc.dao.impl.cdnSystem.CdnSystemDaoImpl" parent="baseDao">
	</bean>
	
	
	
	<!-- >>>>>>>>>>>>>>>>>>>>>Bussiness层的注入<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
	<bean id="cdnSystemBussiness" class="com.fuao.fajxc.bussiness.impl.cdnSystem.CdnSystemBussinessImpl">
		<property name="cdnSystemDao" ref="cdnSystemDao"></property>
	</bean>
	
	
	
	<!-- >>>>>>>>>>>>>>>>>>>>>Action层的注入<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
	<bean id="CdnSystemAction" class="com.fuao.fajxc.action.cdnSystem.CdnSystemAction">
		<property name="cdnSystemBussiness" ref="cdnSystemBussiness"></property>
	</bean>
	
	
	
	
</beans>