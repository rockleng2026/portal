<?xml version="1.0" encoding="gbk"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
    "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
  <package name="approvalproject" extends="struts-default" namespace="/">

     <!-- 项目问题action -->
    <action name="*ApprovalProject" class="approvalProjectAction" method="{1}">
         <result name="wait">/newproject/approveproject/waitapplist.jsp</result>
         <result name="dcwait">/newproject/approveproject/waitapplist_Down.jsp</result>
         <result name="apprecord" type="redirect">appRecordListApprovalProject.do</result>
         <result name="record">/newproject/approveproject/approverecord.jsp</result>
         <result name="dcrecord">/newproject/approveproject/approverecord_Down.jsp</result>
         <result name="procedures">/newproject/startproject/procedures.jsp</result>
    </action>

  </package>

</struts>