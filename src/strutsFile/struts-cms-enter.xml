<struts>
  <package name="PackageLogins" extends="json-default" namespace="/cms">
    <!--login -->
    <action name="adminLoss" class="cmsLoAction" method="LoginEnter">
        <result name="input">/cms/login/login.jsp</result>
        <result name="success">/cms/login/cms.html</result>
    </action>
    <action name="*_MenuAllTrees" class="cmsLoAction" method="{1}">
         <result type="json">
         <param name="arrMessager"></param>
         </result>
    </action>
  </package>

</struts>