<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.1.7//EN"
    "http://struts.apache.org/dtds/struts-2.1.7.dtd">

<struts>
	<package name="packagejson" extends="json-default">
		<action name="*HandleJson" class="handleJsonAction" method="{1}">
			<result name="qclist" type="json">
    			<param name="root">questioncategorylist</param>
    		</result>
    		<result name="dlist" type="json">
    			<param name="root">departlist</param>
    		</result>
    		<result name="cdlist" type="json">
    			<param name="root">commoditylist</param>
    		</result>
    		<result name="missiontypelist" type="json">
    			<param name="root">missiontypelist</param>
    		</result>
    		<result name="groupsgrade" type="json">
    			<param name="root">groupslist</param>
    		</result>
		</action>
	</package>
</struts>