<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.1.7//EN"
    "http://struts.apache.org/dtds/struts-2.1.7.dtd">
<struts>
  <package name="PackageWebBG" extends="struts-default" namespace="/cms">

    <action name="*cmsbg" class="newsAction" method="{1}">
         <result name="update">/cms/papers/paperOut.jsp</result>
         <result name="show">/cms/papers/paperManage.jsp</result>
         <result name="paramerror">/cms/ender/error.jsp</result>
         <result name="weblistproduct">/cms/ender/news_index.jsp</result>
         <result name="webinfoproduct">/cms/ender/news_info.jsp</result>
         <result name="info">/litscloud/lab/lab_content.jsp</result>
         <result name="info_no_param">/litscloud/msg/error.jsp</result>
         <result name="info_no_cid">/litscloud/msg/error.jsp</result>
    </action>
   </package>
  <package name="PackageWebSite" extends="struts-default" namespace="/cms/web">

     <!-- 文章管理action -->
    <action name="*webproduct" class="cmsWebAction" method="{1}">
         <result name="update">/cms/papers/paperOut.jsp</result>
         <result name="show">/cms/papers/paperManage.jsp</result>
         <result name="paramerror">/cms/ender/error.jsp</result>
         <result name="weblistproduct">/cms/ender/product_index.jsp</result>
         <result name="webinfoproduct">/cms/ender/product_info.jsp</result>
         <result name="info">/litscloud/lab/lab_content.jsp</result>
         <result name="info_no_param">/litscloud/msg/error.jsp</result>
         <result name="info_no_cid">/litscloud/msg/error.jsp</result>
    </action>
    <action name="*webnews" class="cmsWebAction" method="{1}">
         <result name="update">/cms/papers/paperOut.jsp</result>
         <result name="show">/cms/papers/paperManage.jsp</result>
         <result name="paramerror">/cms/ender/error.jsp</result>
         <result name="weblistproduct">/cms/ender/news_index.jsp</result>
         <result name="webinfoproduct">/cms/ender/news_info.jsp</result>
         <result name="webinfo2product">/cms/ender/news_info2.jsp</result>
         <result name="info">/litscloud/lab/lab_content.jsp</result>
         <result name="info_no_param">/litscloud/msg/error.jsp</result>
         <result name="info_no_cid">/litscloud/msg/error.jsp</result>
    </action>
    <action name="*webexcute" class="cmsWebAction" method="{1}">
         <result name="ender">/cms/ender/index.jsp</result>
         <result name="error">/cms/ender/error.jsp</result>
    </action>
   </package>
   

</struts>