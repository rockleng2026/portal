         <result name="createUI">/newproject/question_project/addquestion.jsp</result>
         <result name="showquestion">/newproject/question_project/details.jsp</result>
         <result name="find">/newproject/question_project/myquestion.jsp</result>
         <result name="history">/newproject/question_project/historyquestion.jsp</result>
         <result name="onesche">/newproject/question_project/onesche.jsp</result>
         <result name="findnp">/newproject/startproject/projectSpendingRecord.jsp</result>
