     <!-- 项目问题action -->
    <action name="*QuestionProject" class="questionProjectAction" method="{1}">
         <result name="select">/newproject/discuss/questiolist.jsp</result>
         <result name="selectbyid">/newproject/discuss/problem.jsp</result>
         <result name="add">selectIdQuestionProject.do?id=</result>
         <result name="fusion">/fusionChart/report.jsp</result>
