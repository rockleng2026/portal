<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.1.7//EN"
    "http://struts.apache.org/dtds/struts-2.1.7.dtd">
    <struts>
    <package name="PackageOrderSetMeal" extends="struts-default">
    <!-- 自定义拦截器 ，交由spring容器管理 -->
		<interceptors>
			<interceptor name="system" class="LoginInterceptor"></interceptor>
			
			<interceptor-stack name="myInter">
			<interceptor-ref name="system">
			<param name="name">SystemAction拦截</param>
				<!-- 指定要拦截的方法名 -->
				<param name="includeMethods">select</param>	
			</interceptor-ref>
			<!-- 调用每一个拦截器后，必须在后面添加调用默认的拦截器 defaultStack -->
			<interceptor-ref name="defaultStack"/>  
			</interceptor-stack>
		</interceptors>
	
	    <!-- 套餐Action -->
	    <action name="*SetMealAction" class="SetMealAction" method="{1}">
		    <result name="goList">/orderTemplate/setMeal/setMealList.jsp</result>
		    <result name="goAdd">/orderTemplate/setMeal/addSetMeal.jsp</result>
		    <result name="goUpdate">/orderTemplate/setMeal/updateSetMeal.jsp</result>
		    <result name="goInfo">/orderTemplate/setMeal/setMealInfo.jsp</result>
		    <result name="success" type="redirect">goListSetMealAction.do</result>
		    <result name="no">/No.jsp</result>
	    </action>

    
    	<!-- 套餐属性Action -->
	    <action name="*SetMealProAction" class="SetMealProAction" method="{1}">
		    <result name="goList">/orderTemplate/setMeal/setMealPropertyList.jsp</result>
		    <result name="goAdd">/orderTemplate/setMeal/addSetMealProperty.jsp</result>
		    <result name="goUpdate">/orderTemplate/setMeal/updateSetMealProperty.jsp</result>
		    <result name="goInfo">/orderTemplate/setMeal/setMealPropertyInfo.jsp</result>
		    <result name="success" type="redirect">goListSetMealProAction.do</result>
		    <result name="no">/No.jsp</result>
	    </action>
    

     <action name="*orderAction" class="orderAction" method="{1}">
	    <result name="orderTypeList">/orderTemplate/orderType/orderTypeList.jsp</result>
	    <result name="orderTypeInfo">/orderTemplate/orderType/orderType.jsp</result>
	    <result name="update">/orderTemplate/orderType/updateOrderType.jsp</result>
	    <result name="addSaleOrder">/orderTemplate/SaleOrder/addsaleOrder.jsp</result>
	    <result name="taocaninfo">/orderTemplate/SaleOrder/setMealInfo1.jsp</result>
	  	 <result name="saleOrderList" >/orderTemplate/SaleOrder/saleOrderList.jsp</result>
	  	 <result name="saleOrderInfo" >/orderTemplate/SaleOrder/saleOrderInfo.jsp</result>
	     <result name="updatesaleOrder" >/orderTemplate/SaleOrder/updatesaleOrder.jsp</result>
	    <result name="select" type="redirect"></result>
    </action>

    </package>
</struts>