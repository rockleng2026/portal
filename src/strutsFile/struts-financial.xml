<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.1.7//EN"
    "http://struts.apache.org/dtds/struts-2.1.7.dtd">
    
    <struts>
    <!-- 财务操作package -->
    <package name="PackageFinance" extends="struts-default">
    <!-- 自定义拦截器 ，交由spring容器管理 -->
		<interceptors>
			<interceptor name="system" class="LoginInterceptor"></interceptor>
			
			<interceptor-stack name="myInter">
			<interceptor-ref name="system">
			<param name="name">SystemAction拦截</param>
				<!-- 指定要拦截的方法名 -->
				<param name="includeMethods">select</param>	
			</interceptor-ref>
			<!-- 调用每一个拦截器后，必须在后面添加调用默认的拦截器 defaultStack -->
			<interceptor-ref name="defaultStack"/>  
			</interceptor-stack>
		</interceptors>
    <!-- 收款单Action -->
    <action name="*charge" class="ChargeAction" method="{1}">
    <result name="success">/Financial/charge/chargeList.jsp</result>
    <result name="add">/Financial/charge/addCharge.jsp</result>
    <result name="up">/Financial/charge/upCharge.jsp</result>
    <result name="select" type="redirect">selectcharge.do</result>
    <result name="ChargeInfo">/Financial/charge/chargeInfo.jsp</result>

    </action>
    <!-- 付款单Action -->
    <action name="*pay" class="payAction" method="{1}">
     	<!--引用拦截器栈 -->
		<interceptor-ref name="myInter"></interceptor-ref>
    	<result name="success">/Financial/pay/PayDoc.jsp</result>
	    <result name="add">/Financial/pay/addPay.jsp</result>
	    <result name="detail">/Financial/pay/payDetail.jsp</result>
	    <result name="select" type="redirect">selectpay.do?funid=42</result>
    </action>
    <!-- 审核单据Action -->
    <action name="*auditing" class="payAction" method="{1}">
    	<result name="success">/Financial/AuditingDoc.jsp</result>
    </action>
    </package>
    </struts>