<?xml version="1.0" encoding="UTF-8"?>
<beans
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	 http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
	 ">
	 
	
	
	 <!-- >>>>>>>>>>>>>>>>>>>>>Dao层的注入<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
		<!-- 登录dao注入 -->
		<bean id="SchedulePlanDao" class="com.fuao.fajxc.dao.impl.schedulePlan.SchedulePlanDaoImpl" parent="baseDao"></bean>


		<!-- >>>>>>>>>>>>>>>>>>>>>>Bussiness层的注入<<<<<<<<<<<<<<<<<<<< -->
		<!-- 登录Bussiness注入 -->
		<bean id="SchedulePlanBiz" class="com.fuao.fajxc.bussiness.impl.schedulePlan.SchedulePlanBusinessImpl">
			<property name="dao" ref="SchedulePlanDao"></property>
		</bean>

		
		<!-- >>>>>>>>>>>>>>>>>>>>>>>action层的注入<<<<<<<<<<<<<<<<<<<<<<<< -->
		<!-- 登录Action注入 -->
		<bean id="SchedulePlaningAction" class="com.fuao.fajxc.action.schedulePlan.SchedulePlaningAction">
			<property name="spbiz" ref="SchedulePlanBiz"></property>
			<property name="empbiz" ref="empBussiness"></property>
			<property name="executeRecordBussiness" ref="executeRecordBussiness"></property>
			<property name="questionProject" ref="questiondao"></property>
		</bean>
		
	 </beans>