<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.1.7//EN"
    "http://struts.apache.org/dtds/struts-2.1.7.dtd">
    
    <!-- 试卷的struts -->
    <struts>
       <package name="papermanage" extends="struts-default" namespace="/cms">
            <action name="*ExamPapers" class="paperActions" method="{1}" >
                <result name="splits">/examSys/pages/paperManage.jsp</result>
            </action>
       </package>
       
       <package name="examPapers" extends="struts-default">
       		<action name="*ModelAction" class="modelAction" method="{1}">
   				<result name="update">UpdateModel.jsp</result>
   				<result name="add">AddModel.jsp</result>
   				<result name="modelMain">ModelHomepage.jsp</result>
  			 </action>
       </package>

    </struts>
