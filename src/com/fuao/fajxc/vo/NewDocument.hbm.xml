<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
<class name="com.fuao.fajxc.vo.NewDocument" table="new_document">
  <id name="id" column="id" type="integer">
   <generator class="native"></generator>
  </id>
  <property name="filepath" column="filepath" type="string"/>
  <property name="filename" column="filename" type="string"/>
  <property name="pid" column="pid" type="integer" insert="false" update="false"/>
  <many-to-one name="newProject" class="com.fuao.fajxc.vo.NewProject" fetch="select" lazy="false">
            <column name="pid" />
  </many-to-one>
</class>
</hibernate-mapping>
