<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
<class table="workorder" name="com.fuao.fajxc.vo.Workorder">
  <id name="id" column="id" type="integer">
    <generator class="native"></generator>
  </id>
  <many-to-one name="saleorder" class="com.fuao.fajxc.vo.SaleOrder" column="saleorderId" fetch="select"></many-to-one>
  <many-to-one name="upserver" class="com.fuao.fajxc.vo.UpServer" column="upserverId" fetch="select"></many-to-one>
  <property name="problemType" column="problemType" type="string"></property>
  <property name="problemInfo" column="problemInfo" type="string"></property>
  <property name="status" column="status" type="integer"></property>
  <property name="temp" column="temp" type="string"></property>
  <property name="workorderNo" column="workorderNo" type="string"></property>
  <many-to-one name="saleOrders" class="com.fuao.fajxc.vo.Sale_orders" column="saleorder"></many-to-one>
</class>
</hibernate-mapping>
