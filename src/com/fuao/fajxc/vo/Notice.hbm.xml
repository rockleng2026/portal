<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
  <class name="com.fuao.fajxc.vo.Notice" table="notice">
    <id name="id" column="id" type="integer">
      <generator class="native"></generator>
    </id>
    
    <property name="title" column="title" type="string"></property>
    <property name="noticeNo" column="noticeNo" type="string"></property>
    <property name="typeid" column="typeid" type="integer"></property>
    <property name="content" column="content" type="string"></property>
    <property name="audtitingFlag" column="audtitingFlag" type="integer"></property>
    <property name="draftFlag" column="draftFlag" type="integer"></property>
    <property name="sendTime" column="sendTime" type="date"></property>
    <property name="isRead" column="isRead" type="integer"></property>
    
    <many-to-one name="startDept" class="com.fuao.fajxc.vo.Department" column="startDept" fetch="select"></many-to-one>
  </class>
</hibernate-mapping>
