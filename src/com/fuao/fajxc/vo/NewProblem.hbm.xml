<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
<class name="com.fuao.fajxc.vo.NewProblem" table="new_problem">
  <id name="id" column="id" type="integer">
    <generator class="native"></generator>
  </id>
  <property name="contents" column="contents" type="string"/>
  <property name="time" column="time" type="string"/>
  <property name="problemortask" column="problemortask" type="integer"/>
  <property name="isend" column="isend" type="integer"/>
  <property name="count" column="count" type="integer"/>
  <property name="temp1" column="temp1" type="string"></property>
  <property name="temp2" column="temp2" type="string"></property>
  
  <many-to-one name="newQuestion" class="com.fuao.fajxc.vo.NewQuestion">
  	<column name="pid"></column>
  </many-to-one>
  <many-to-one name="employee" class="com.fuao.fajxc.vo.Employee" fetch="select" lazy="false">
  	<column name="empid"></column>
  </many-to-one>
  <many-to-one name="scheduleplan" class="com.fuao.fajxc.vo.Scheduleplan" fetch="select" lazy="false">
  	<column name="sid"></column>
  </many-to-one>
</class>
</hibernate-mapping>
