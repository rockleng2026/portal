<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
<class name="com.fuao.fajxc.vo.NoticeDept" table="notice_dept">
  <id name="id" column="id" type="integer">
    <generator class="native"></generator>
  </id>
  <many-to-one name="notice" column="nid" class="com.fuao.fajxc.vo.Notice" fetch="select"></many-to-one>
  <many-to-one name="dept" column="dept" class="com.fuao.fajxc.vo.Department" fetch="select"></many-to-one>
</class>
</hibernate-mapping>
