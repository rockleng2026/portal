<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
<class name="com.fuao.fajxc.vo.NewFunctionDelRecord" table="new_function_delRecord">
  <id name="id" column="id" type="integer">
    <generator class="native"></generator>
  </id>
  <property name="flag" column="flag" type="integer"/>
  <property name="deldate" column="deldate" type="date"/>
  <many-to-one name="function" class="com.fuao.fajxc.vo.NewFunction" fetch="select" lazy="proxy">
            <column name="fid" />
  </many-to-one>
</class>
</hibernate-mapping>

