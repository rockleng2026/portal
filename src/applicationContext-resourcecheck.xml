<?xml version="1.0" encoding="UTF-8"?>
<beans
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	 http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
	 ">	 
	
	<!-- 资源核实单 -->
	<!-- 注入dao -->
	 <bean id="checkdao" class="com.fuao.fajxc.dao.impl.resourcecheck.ResourceCheckImpl" parent="baseDao">
	 </bean>
	 <!-- 注入action -->
	 <bean id="resourceCheckAction" class="com.fuao.fajxc.action.resourcecheck.ResourceCheckAction">
	 	<property name="checkdao" ref="checkdao"></property>
	 	<property name="audBussiness" ref="auditingBussiness"></property>
	 </bean>
</beans>