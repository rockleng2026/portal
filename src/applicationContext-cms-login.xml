<?xml version="1.0" encoding="UTF-8"?>
<beans
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	 http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
	 ">	 

	<!-- >>>>>>>>>>>>>>>>>>>>>Dao层的注入<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
	
	<bean id="loginDao" class="com.fuao.fajxc.dao.cms_loggin.LoginDaoImpl">
	    <property name="sessionFactory" ref="sessionFactory"></property>
    </bean>
   
	<!-- >>>>>>>>>>>>>>>>>>>>>>Bussiness层的注入<<<<<<<<<<<<<<<<<<<< -->

	<bean id="loginService" class="com.fuao.fajxc.bussiness.cms_loggin.Loginserviceimpl">
		<property name="loginDo" ref="loginDao"/>
		<property name="adminMode" ref="adminmodelDao"></property>
	</bean>
	
	<!-- >>>>>>>>>>>>>>>>>>>>>>>action层的注入<<<<<<<<<<<<<<<<<<<<<<<< -->

	<bean id="cmsLoAction" class="com.fuao.fajxc.action.cms_loggin.LoginAction">
		<property name="loginSer" ref="loginService"></property>
	</bean>

</beans>