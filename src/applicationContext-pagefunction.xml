<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	 http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
	 ">

	<!-- 注入pagefunctiondaoimpl(页面功能链接) -->

	<bean id="pagefunctiondao"
		class="com.fuao.fajxc.dao.impl.pageFunction.PageFunctionDAOImpl"
		parent="baseDao"></bean>
	

	<!-- 注入pagefunctionaction -->
	<bean id="pageFunctionAction" class="com.fuao.fajxc.action.pagefunction.PageFunctionAction">
		<property name="functionDAO" ref="pagefunctiondao"></property>
	</bean>
</beans>